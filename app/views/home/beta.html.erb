<div class="text-center">
  <h1>Welcome to the private beta! 🥳</h1>
  <% if params[:ref].present? %>
    <p class="text-muted">Referred by <%= params[:ref].upcase %></p>
  <% else %>
    <p class="text-muted">Glad you found us.</p>
  <% end %>
  <p class="lead">Please proceed to setup by authenticating with your GitHub account.<br/>If anything goes sideways, <a href="mailto:help@undercover-ci.com">let me know!</a></p>

  <%= link_to "Sign Up with GitHub", "/auth/github", class: "btn btn-lg btn-primary", method: :post %>
</div>
